import re

configfile: "config.yaml"

IZLAZ = config["izlaz"]


# Jedna ulazna tocka za cijeli pipeline.
#
#   snakemake --cores 1
#   snakemake --cores 1 --config filtar="cisticola"
#   snakemake --cores 1 --config filtar="Notharchus" fuzzy_prag=85
#
# Vrijednosti zadane preko --config nadjacavaju config.yaml.
if "filtar" in config:
    config["izvjestaj"]["filtar"] = config["filtar"]
if "fuzzy_prag" in config:
    config["izvjestaj"]["fuzzy_prag"] = int(config["fuzzy_prag"])


def nastavak_izvjestaja():
    """Filtrirani izvjestaj dobiva vlastito ime.

    Bez ovoga bi pokretanje s filtrom prepisalo glavni izvjestaj, pa bi
    rezultati/vrste.csv sadrzavao samo suzeni skup dok se pipeline ne pokrene
    ponovno bez filtra.
    """
    filtar = str(config["izvjestaj"].get("filtar") or "").strip()
    if not filtar:
        return ""

    oznaka = re.sub(r"[^A-Za-z0-9]+", "-", filtar).strip("-").lower()
    return f"_{oznaka}" if oznaka else ""


NASTAVAK = nastavak_izvjestaja()

CSV = f"{IZLAZ}/vrste{NASTAVAK}.csv"
SLIKA = f"{IZLAZ}/vrste{NASTAVAK}.png"
IZVJESTAJ = f"{IZLAZ}/izvjestaj{NASTAVAK}.json"
VIZUALIZACIJA = f"{IZLAZ}/vizualizacija{NASTAVAK}.json"


rule sve:
    input:
        f"{IZLAZ}/taksonomija.json",
        f"{IZLAZ}/datoteke.json",
        f"{IZLAZ}/klasifikacija.json",
        f"{IZLAZ}/opazanja.json",
        IZVJESTAJ,
        VIZUALIZACIJA,


rule taksonomija:
    output:
        f"{IZLAZ}/taksonomija.json",
    script:
        "skripte/taksonomija.py"


rule datoteke:
    output:
        f"{IZLAZ}/datoteke.json",
    script:
        "skripte/datoteke.py"


rule klasifikacija:
    input:
        f"{IZLAZ}/taksonomija.json",
        f"{IZLAZ}/datoteke.json",
    output:
        f"{IZLAZ}/klasifikacija.json",
    script:
        "skripte/klasifikacija.py"


rule opazanja:
    input:
        f"{IZLAZ}/taksonomija.json",
    output:
        f"{IZLAZ}/opazanja.json",
    script:
        "skripte/opazanja.py"


rule izvjestaj:
    input:
        f"{IZLAZ}/klasifikacija.json",
        f"{IZLAZ}/opazanja.json",
    output:
        CSV,
        IZVJESTAJ,
    script:
        "skripte/izvjestaj.py"


rule vizualizacija:
    input:
        CSV,
    output:
        SLIKA,
        VIZUALIZACIJA,
    script:
        "skripte/vizualizacija.py"


# Brise sve izlaze pipelinea, da sljedece pokretanje krene ispocetka.
# Podaci u MongoDB i MinIO ostaju - njih se cisti zasebno.
rule ocisti:
    run:
        import shutil
        from pathlib import Path

        putanja = Path(IZLAZ)
        if putanja.exists():
            shutil.rmtree(putanja)
            print(f"Obrisano: {putanja}")
        else:
            print(f"Nema sto brisati u {putanja}.")
